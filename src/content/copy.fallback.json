    { "key": "faq.3.a", "section": "Questions", "what": "Answer 3", "copy": "Your presence is the gift. If you insist, a note for the bowl." },
    { "key": "faq.4.q", "section": "Questions", "what": "Question 4", "copy": "Where do I park?" },
    { "key": "faq.4.a", "section": "Questions", "what": "Answer 4", "copy": "The chapel has twenty guest spaces inside the gate, with accessible spaces closer to the door. ⟨Reception parking⟩" },
