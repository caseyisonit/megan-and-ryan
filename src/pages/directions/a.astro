---
import { Picture } from 'astro:assets';
import Lab from '../../layouts/Lab.astro';
import couple from '../../assets/plates/cropped/couple.png';
import { day, event } from '../../data/event';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Lab title="Direction A · Collodion — Megan & Ryan">
  <Fragment set:html={`<!--
THESIS: The site is a 19th-century cabinet card from a tintype studio. Refuses the cream-serif-mono wedding template.
OWN-WORLD: Bone (limestone/plate silver) ground, ink type, IM Fell letterpress faces, poured collodion edges, studio imprint lines. No mono.
STORY: Guests see the couple as a plate, learn when and where, and accept.
FIRST VIEWPORT: Plate III centred; MEGAN (top-left) and & RYAN (bottom-right) at ~17vw cross the plate in difference blend; lede + Accept bottom-left; studio imprint top-right.
FORM: Cabinet card, rank 1 of the research list.
-->`} />
  <a class="skip" href="#day">Skip to the day</a>
  <header class="nav">
    <a href={`${base}/directions/`} class="mark">M · R</a>
    <nav aria-label="Sections">
      <a href="#story">Story</a><a href="#day">The Day</a><a href="#rite">The Rite</a><a href="#stay">Stay</a>
    </nav>
    <a href="#attend" class="reply">Reply</a>
  </header>

  <main>
    <section class="hero" aria-labelledby="names">
      <h1 id="names" class="names" data-melt>
        <span class="n1">{event.names[0]}</span>
        <span class="n2"><i>&amp;</i> {event.names[1]}</span>
      </h1>

      <figure class="plate" data-develop>
        <span class="pour" aria-hidden="true"></span>
        <Picture
          src={couple}
          formats={['avif', 'webp']}
          widths={[480, 760, 1100]}
          sizes="(min-width: 900px) 40vw, 86vw"
          alt="Megan and Ryan, a wet-plate portrait: she holds an armful of white calla lilies, he stands close in a black suit."
          loading="eager"
        />
        <figcaption>Plate III — The two of them <span>Nº 003</span></figcaption>
      </figure>

      <p class="imprint">
        A rite in the Hill Country<br />
        <span>{event.date}<br />{event.place}</span>
      </p>

      <div class="call">
        <p class="lede">{event.lede}</p>
        <div class="actions">
          <a class="btn" href="#attend">Accept the invitation</a>
          <span class="by">Reply by<br />{event.replyBy}</span>
        </div>
      </div>
    </section>

    <section id="day" class="day" aria-labelledby="day-h">
      <h2 id="day-h">Light moves; <i>so do we</i></h2>
      <p class="day-date">{event.date}</p>
      <ol class="rows">
        {
          day.map((r) => (
            <li class="row">
              <p class="time" data-shadow={r.time} style={`--stretch:.25`}>
                <span>{r.time}</span>
                <small>{r.meridiem}</small>
              </p>
              <div class="what">
                <h3>{r.title}</h3>
                <p class="place">{r.place}</p>
                <p class="line">{r.line}</p>
              </div>
              {r.address.length > 0 && (
                <address>
                  {r.address[0]}
                  <br />
                  {r.address[1]}
                  {r.note && <span class="note">{r.note}</span>}
                  <a href={r.map} rel="noopener">Open in Maps <span aria-hidden="true">↗</span></a>
                </address>
              )}
            </li>
          ))
        }
      </ol>
    </section>
  </main>
</Lab>

<style>
  :global(body) {
    background: var(--color-bone);
    color: var(--color-ink);
    font-family: 'IM Fell English', serif;
    font-size: 19px;
    line-height: 1.5;
  }

  .skip {
    position: absolute;
    left: -999px;
  }
  .skip:focus {
    left: var(--gutter);
    top: 8px;
    z-index: 10;
    background: var(--color-ink);
    color: var(--color-bone);
    padding: 8px 12px;
  }

  .nav {
    position: sticky;
    top: 0;
    z-index: 5;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 18px var(--gutter);
    font-family: 'IM Fell English SC', serif;
    font-size: 17px;
    letter-spacing: 0.08em;
    background: color-mix(in srgb, var(--color-bone) 88%, transparent);
    backdrop-filter: blur(6px);
  }
  .nav a {
    text-decoration: none;
  }
  .nav nav {
    display: flex;
    gap: clamp(16px, 3vw, 40px);
  }
  .nav .reply {
    justify-self: end;
    border-bottom: 1px solid currentColor;
  }

  /* ---------- Hero: cabinet card ---------- */
  .hero {
    position: relative;
    height: max(720px, calc(100svh - 64px));
    display: grid;
    grid-template-columns: 1fr minmax(300px, 36vw) 1fr;
    grid-template-rows: 1fr auto 1fr;
    padding: clamp(16px, 3vw, 40px) var(--gutter) clamp(32px, 5vw, 64px);
    isolation: isolate;
    background: var(--color-bone);
  }

  .names {
    position: absolute;
    inset: 0 var(--gutter);
    z-index: 2;
    margin: 0;
    pointer-events: none;
    font-family: 'IM Fell Double Pica', serif;
    font-weight: 400;
    font-size: clamp(88px, 17vw, 300px);
    line-height: 0.82;
    letter-spacing: -0.035em;
    color: var(--color-bone);
    mix-blend-mode: difference;
    filter: url(#melt);
  }
  .names span {
    position: absolute;
    white-space: nowrap;
  }
  .n1 {
    top: 0.06em;
    left: -0.04em;
  }
  .n2 {
    right: -0.02em;
    bottom: 0.12em;
  }
  .n2 i {
    font-style: italic;
  }

  .plate {
    grid-column: 2;
    grid-row: 2;
    align-self: center;
    position: relative;
    margin: 0;
    padding: 14px;
  }
  .pour {
    position: absolute;
    inset: 0;
    background: var(--color-ink);
    filter: url(#pour);
    z-index: -1;
  }
  .plate :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 1500 / 1130;
    object-fit: cover;
    filter: brightness(0) contrast(1);
    transition: filter 2.4s var(--ease-rite);
    box-shadow: inset 0 0 80px #000;
  }
  .plate.is-developed :global(img) {
    filter: none;
    animation: develop 2.4s var(--ease-rite);
  }
  @keyframes develop {
    0% {
      filter: brightness(0);
    }
    45% {
      filter: brightness(1.7) contrast(0.55) blur(1px);
    }
    100% {
      filter: none;
    }
  }
  .plate figcaption {
    position: absolute;
    top: 14px;
    left: calc(100% + 14px);
    writing-mode: vertical-rl;
    display: flex;
    justify-content: space-between;
    height: calc(100% - 28px);
    font-family: 'IM Fell English SC', serif;
    font-size: 15px;
    letter-spacing: 0.08em;
    color: var(--color-smoke);
    white-space: nowrap;
  }

  .imprint {
    grid-column: 3;
    grid-row: 1;
    justify-self: end;
    align-self: end;
    text-align: right;
    font-family: 'IM Fell English SC', serif;
    font-size: 17px;
    line-height: 1.45;
    letter-spacing: 0.06em;
    padding-bottom: 24px;
  }
  .imprint span {
    color: var(--color-smoke);
  }

  .call {
    grid-column: 1 / span 2;
    grid-row: 3;
    align-self: end;
    max-width: 34ch;
    position: relative;
    z-index: 3;
    padding-top: 24px;
  }
  .lede {
    font-size: clamp(20px, 1.2vw + 12px, 26px);
    line-height: 1.32;
    text-wrap: pretty;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-top: 28px;
  }
  .btn {
    display: inline-block;
    padding: 16px 26px 14px;
    background: var(--color-ink);
    color: var(--color-bone);
    font-family: 'IM Fell English SC', serif;
    font-size: 19px;
    letter-spacing: 0.06em;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.4s var(--ease-rite), color 0.4s var(--ease-rite);
  }
  .btn:hover {
    background: var(--color-void);
    color: var(--color-pure);
  }
  .by {
    font-family: 'IM Fell English SC', serif;
    font-size: 15px;
    line-height: 1.3;
    letter-spacing: 0.06em;
    color: var(--color-smoke);
    white-space: nowrap;
  }

  /* ---------- The Day ---------- */
  .day {
    padding: clamp(96px, 12vw, 180px) var(--gutter) clamp(96px, 10vw, 160px);
  }
  .day h2 {
    font-family: 'IM Fell Double Pica', serif;
    font-weight: 400;
    font-size: clamp(48px, 7.5vw, 128px);
    line-height: 0.95;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .day-date {
    margin-top: 16px;
    font-family: 'IM Fell English SC', serif;
    letter-spacing: 0.06em;
    color: var(--color-smoke);
  }
  .rows {
    margin-top: clamp(48px, 7vw, 96px);
    border-top: 1px solid var(--color-ink);
  }
  .row {
    display: grid;
    grid-template-columns: minmax(200px, 22vw) minmax(0, 1fr) minmax(220px, 24vw);
    gap: clamp(20px, 3vw, 56px);
    padding: clamp(28px, 3.5vw, 48px) 0 clamp(56px, 6vw, 88px);
    border-bottom: 1px solid var(--color-mist);
  }
  .time {
    position: relative;
    font-family: 'IM Fell Double Pica', serif;
    font-size: clamp(64px, 8vw, 132px);
    line-height: 0.8;
    letter-spacing: -0.03em;
    font-variant-numeric: oldstyle-nums;
  }
  .time small {
    font-family: 'IM Fell English SC', serif;
    font-size: 0.18em;
    letter-spacing: 0.08em;
    margin-left: 0.2em;
  }
  /* Long shadow: the numeral laid flat on the ground, stretched by scroll */
  .time::after {
    content: attr(data-shadow);
    position: absolute;
    left: 0;
    top: 0;
    z-index: -1;
    color: var(--color-ink);
    opacity: 0.14;
    transform-origin: 0 82%;
    transform: skewX(calc(-58deg * var(--stretch))) scaleY(calc(-0.55 * var(--stretch)));
    -webkit-mask-image: linear-gradient(90deg, #000 20%, transparent 95%);
    mask-image: linear-gradient(90deg, #000 20%, transparent 95%);
    pointer-events: none;
  }
  .what h3 {
    font-family: 'IM Fell English SC', serif;
    font-weight: 400;
    font-size: 18px;
    letter-spacing: 0.08em;
    color: var(--color-smoke);
  }
  .place {
    margin-top: 6px;
    font-family: 'IM Fell Double Pica', serif;
    font-size: clamp(30px, 2.6vw, 44px);
    line-height: 1.05;
  }
  .line {
    margin-top: 14px;
    max-width: 38ch;
  }
  address {
    font-style: normal;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-top: 6px;
  }
  .note {
    margin-top: 10px;
    font-style: italic;
    color: var(--color-smoke);
  }
  address a {
    margin-top: 14px;
    align-self: flex-start;
    text-underline-offset: 5px;
    font-family: 'IM Fell English SC', serif;
    letter-spacing: 0.06em;
  }

  /* ---------- Mobile ---------- */
  @media (max-width: 760px) {
    .nav nav {
      display: none;
    }
    .nav {
      grid-template-columns: 1fr 1fr;
    }
    .hero {
      display: flex;
      flex-direction: column;
      height: auto;
      padding-top: 8px;
    }
    .names {
      position: relative;
      inset: auto;
      font-size: clamp(76px, 25vw, 150px);
      line-height: 0.86;
    }
    .names span {
      position: static;
      display: block;
    }
    .n2 {
      text-align: right;
    }
    .plate {
      margin-top: -0.32em;
      font-size: clamp(76px, 25vw, 150px);
      padding: 10px;
    }
    .plate figcaption {
      position: static;
      writing-mode: horizontal-tb;
      height: auto;
      margin-top: 18px;
      font-size: 15px;
      gap: 12px;
    }
    .imprint,
    .call {
      align-self: stretch;
      justify-self: auto;
      text-align: left;
    }
    .imprint {
      padding: 28px 0 0;
    }
    .call {
      padding-top: 28px;
    }
    .row {
      grid-template-columns: 1fr;
      gap: 18px;
    }
  }
</style>
